# ==========================================
# 한국 주식 자동매매 봇 v5.1 — 환경변수 설정
# ==========================================
# ⚠️  이 파일을 복사해 .env로 저장한 뒤 실제 값을 입력하세요.
#     cp .env.example .env

# ==========================================
# 전략 선택
# ==========================================
# rebalance: ETF 듀얼모멘텀·VAA 월간 리밸런싱 (기본)
# breakout : 스윙 눌림목 스캔 + TP/SL 자동매매 (레거시)
STRATEGY_MODE=rebalance

# 리밸런싱 전략 (STRATEGY_MODE=rebalance 일 때만 사용)
# kr_asset_momentum | kr_gem | kr_growth | kr_leaders | vaa_kr | kr_ensemble
# kr_ensemble: 듀얼모멘텀 3종 비중 평균 — 단일 전략 선택 위험을 분산
STRATEGY_KEY=kr_gem

# 매월 첫 거래일 자동 리밸런싱 실행 시각 (HH:MM, KST)
# ⚠️ 09:00~09:10 설정 금지 — 국내 ETF LP는 장 개시 후 5분간 호가 제출 의무가
#    면제되어 스프레드가 크게 벌어진다. 이 봇은 시장가 주문이라 그 손실을 그대로 부담.
#    유동성이 회복된 10:00 이후를 쓴다(월 1회 주문이라 전략 성격은 바뀌지 않음).
REBALANCE_TIME=10:00

# 매수 여력 버퍼 — 목표금액을 총자산의 이 비율로 계산
# 조회가와 실제 체결가 차이로 "주문가능금액 부족"이 나면 그 달 매수가 통째로 실패하므로
# 여유를 둔다. 갭이 잦으면 0.99로 낮출 것.
REBALANCE_CASH_BUFFER=0.995

# 전략 리뷰 — 매월 이 날짜에 5개 전략을 실데이터로 백테스트해 텔레그램 보고.
# 리밸런싱(첫 거래일) 전에 여유를 두고 받도록 25일 기본. 0이면 자동 발송 안 함.
# 즉시 실행은 텔레그램 /review
STRATEGY_REVIEW_DAY=25
STRATEGY_REVIEW_TIME=18:00

# ==========================================
# 텔레그램
# ==========================================
# 봇 토큰 (@BotFather)
TELEGRAM_TOKEN=your_telegram_bot_token_here

# 채팅방 ID (여러 개면 콤마로 구분)
# 일반 채팅방:  123456789
# 토픽 그룹:    -1003872236237  (슈퍼그룹은 앞에 -100 붙음)
TELEGRAM_CHAT_IDS=your_chat_id_here

# 토픽(스레드) ID — 일반 채팅방이면 비워두세요
# https://t.me/c/3872236237/6/7  →  토픽 ID = 6
TELEGRAM_TOPIC_ID=

# ==========================================
# 한국투자증권 KIS API
# ==========================================
KIS_APP_KEY=your_kis_app_key_here
KIS_APP_SECRET=your_kis_app_secret_here

# 투자 모드: paper(모의투자) 또는 real(실전투자)
KIS_MODE=paper

# 계좌번호 (숫자만 or 하이픈 포함 모두 가능) — 자동매매 필수
# 예: 50071234-01  또는  5007123401
KIS_ACCOUNT_NO=your_account_number_here

# ==========================================
# 자동매매
# ==========================================
# true: 자동 주문 실행 / false: 알림만 발송 (기본값)
AUTO_TRADE=false

# (눌림목 모드) 종목당 최대 투자금액 (원)
TRADE_AMOUNT_PER_STOCK=1000000

# ==========================================
# 웹 대시보드
# ==========================================
# 접속 토큰 — 필수, 20자 이상 (미설정 시 대시보드 기동 거부)
# 생성 예: python -c "import secrets; print(secrets.token_urlsafe(24))"
DASHBOARD_TOKEN=
